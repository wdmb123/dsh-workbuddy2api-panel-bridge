{
  "name": "dsh-workbuddy2api-panel-bridge",
  "displayName": "DSH WorkBuddy2API Panel Bridge",
  "description": "把本机自托管的 WorkBuddy2API 反代网关（OpenAI 兼容 /v1）接进 DeepSeek Harness，作为可选的模型供应商；配置走一张卡片，不用改配置文件。",
  "version": "0.1.2",
  "license": "MIT",
  "author": "local",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "workbuddy2api",
    "openai-compatible",
    "model-provider",
    "gateway"
  ],
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.1.5-rc.1 <0.3.0"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "bin": {
    "dsh-workbuddy2api-panel-bridge": "lib/bin.js"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "AIREADME.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings-plugins",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1-rc.1",
    "@deepseek-ai/dsh-llm": ">=0.1.1-rc.1 <0.3.0",
    "@deepseek-ai/dsh-llm-pi-ai": ">=0.1.1-rc.1 <0.3.0",
    "@earendil-works/pi-ai": ">=0.82.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm-pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-ai": {
      "optional": true
    }
  }
}
